{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-orchestra.local/schemas/RESULT.schema.json",
  "title": "AI_ORCHESTRA Result",
  "description": "Final outcome of a completed run. Publication fields are present only when work was actually published.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "final_state",
    "summary"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Identifier of the task this result belongs to.",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "description": "Coarse outcome of the run.",
      "enum": [
        "SUCCESS",
        "FAILED",
        "CANCELLED",
        "HUMAN_REQUIRED"
      ]
    },
    "final_state": {
      "type": "string",
      "description": "Terminal state of the orchestration state machine.",
      "enum": [
        "CREATED",
        "PLANNING",
        "WORKER_RUNNING",
        "WORKER_DONE",
        "VALIDATING",
        "REVIEWING",
        "CORRECTION_REQUIRED",
        "APPROVED",
        "PUBLISHING",
        "PUBLISHED",
        "HUMAN_REQUIRED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "summary": {
      "type": "string",
      "description": "Concise description of the run outcome.",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "description": "Task branch that was published, when applicable.",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "description": "Commit SHA produced by publication, when applicable.",
      "minLength": 1
    },
    "pull_request": {
      "type": "string",
      "description": "Pull request URL or number, when applicable.",
      "minLength": 1
    },
    "completed_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of run completion.",
      "format": "date-time"
    }
  }
}
